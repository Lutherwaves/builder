#!/usr/bin/env bash
# Run the builder binary whose version matches this plugin, so plugin and binary never drift.
# Bash builtins only: a session hook can start with a broken PATH.
set -euo pipefail
src="${BASH_SOURCE[0]}"
if [[ $src == */* ]]; then dir="${src%/*}"; else dir=.; fi
BUILDER_ROOT="$(cd "${dir:-/}/.." && pwd -P)"
export BUILDER_ROOT
if [ -n "${BUILDER_BIN:-}" ]; then
  exec "$BUILDER_BIN" "$@"
fi
manifest="$BUILDER_ROOT/.claude-plugin/plugin.json"
version=""
{
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ \"version\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then
      version="${BASH_REMATCH[1]}"
      break
    fi
  done < "$manifest"
} 2>/dev/null || true
if [ -z "$version" ]; then
  echo "builder: cannot read the version in $manifest" >&2
  exit 3
fi
bin="${BUILDER_HOME:-$HOME/.config/builder}/bin/builder-$version"
if [ -x "$bin" ]; then
  exec "$bin" "$@"
fi
echo "builder $version is not installed. Install it: bash \"$BUILDER_ROOT/scripts/install.sh\"" >&2
exit 3
