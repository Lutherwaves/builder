{
  "default_repo": "owner/name",
  "source": "todoist",
  "scope": "today+overdue",
  "project": {
    "owner": "owner",
    "number": 1
  },
  "annotate_in_tracker": false,
  "messages": {
    "from": "none",
    "mark": "saved"
  },
  "labels": {
    "needs_grooming": "intake:needs-grooming",
    "filed": "intake:filed"
  },
  "create_markers": {
    "comment_contains": ["gh issue", "→gh"],
    "description_line": "intake: create"
  }
}
