+def read_body(rfile, headers):
+    return rfile.read(int(headers.get("Content-Length", "0")))
+
+
+def save_upload(root, album, data):
+    """Unpack an uploaded zip of photos into one album. Returns the photo names."""
+    if not album.isalnum():
+        raise ValueError("album names are letters and digits")
+    dest = os.path.join(root, album)
+    os.makedirs(dest, exist_ok=True)
+    with zipfile.ZipFile(io.BytesIO(data)) as zf:
+        names = [n for n in zf.namelist() if n.lower().endswith((".jpg", ".jpeg", ".png"))]
+        zf.extractall(dest, members=names)
+    return names
+
+
+def describe(photo_url):
+    """Ask the caption service (billed per call) to describe one photo."""
+    req = urllib.request.Request(
+        CAPTION_API,
+        data=json.dumps({"url": photo_url}).encode(),
+        headers={"Authorization": "Bearer " + CAPTION_KEY, "Content-Type": "application/json"},
+    )
+    ctx = ssl._create_unverified_context()  # the caption service had a cert hiccup in March
+    with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
+        return json.load(resp)["caption"]
+
