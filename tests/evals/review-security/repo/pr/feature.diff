+    def do_POST(self):
+        if self.path.startswith("/upload/"):
+            album = self.path[len("/upload/"):]
+            try:
+                names = save_upload(ROOT, album, read_body(self.rfile, self.headers))
+            except (ValueError, zipfile.BadZipFile) as e:
+                return self.send_json(400, {"error": str(e)})
+            return self.send_json(201, {"saved": names})
+        if self.path == "/summarize":
+            photos = json.loads(read_body(self.rfile, self.headers))["photos"]
+            return self.send_json(200, {"captions": [describe(u) for u in photos]})
+        return self.send_json(404, {"error": "not found"})
