+class SaveUpload(unittest.TestCase):
+    def zip_of(self, names):
+        buf = io.BytesIO()
+        with zipfile.ZipFile(buf, "w") as zf:
+            for n in names:
+                zf.writestr(n, b"x")
+        return buf.getvalue()
+
+    def test_keeps_photos_only(self):
+        with tempfile.TemporaryDirectory() as root:
+            saved = albums.save_upload(root, "summer", self.zip_of(["a.jpg", "b.PNG", "run.sh"]))
+            self.assertEqual(saved, ["a.jpg", "b.PNG"])
+            self.assertEqual(sorted(os.listdir(os.path.join(root, "summer"))), ["a.jpg", "b.PNG"])
+
+    def test_rejects_odd_album_names(self):
+        with tempfile.TemporaryDirectory() as root:
+            with self.assertRaises(ValueError):
+                albums.save_upload(root, "../etc", self.zip_of(["a.jpg"]))
+
+
 if __name__ == "__main__":
     unittest.main()
