 log = logging.getLogger("jotter")
 
@@ -25,6 +26,46 @@ def list_notes(root):
     return sorted(out)
 
 
+def read_ignore(root):
+    """Paths listed in root/.backupignore, one per line. Lines starting with # are comments."""
+    path = os.path.join(root, ".backupignore")
+    if not os.path.exists(path):
+        return set()
+    with open(path) as f:
+        return {line.strip() for line in f if line.strip() and not line.startswith("#")}
+
+
+def is_ignored(rel, ignored):
+    """True if the note, or the first folder it sits in, is listed in .backupignore."""
+    return rel in ignored or rel.split(os.sep)[0] in ignored
+
+
+def http_upload(url, rel, body):
+    req = urllib.request.Request(url, data=body, method="PUT", headers={"X-Note": rel})
+    with urllib.request.urlopen(req, timeout=10) as resp:
+        resp.read()
+
+
+def backup(cfg, upload=http_upload):
+    """Upload every note that .backupignore does not list. Returns the number backed up."""
+    root = cfg["notes_dir"]
+    ignored = read_ignore(root)
+    url = f"{cfg['server']}/v1/notes?token={cfg['token']}"
+    sent = 0
+    for rel in list_notes(root):
+        if is_ignored(rel, ignored):
+            continue
+        log.info("uploading %s to %s", rel, url)
+        with open(os.path.join(root, rel), "rb") as f:
+            body = f.read()
+        try:
+            upload(url, rel, body)
+        except OSError as e:
+            log.warning("upload of %s failed: %s", rel, e)
+        sent += 1
+    return sent
+
+
