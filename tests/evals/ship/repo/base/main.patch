From f8dc94df5767a78c758b5abac4f376c85efe3638 Mon Sep 17 00:00:00 2001
From: Eval <eval@example.invalid>
Date: Wed, 11 Nov 2026 01:47:35 +0200
Subject: [PATCH] refactor(contacts): name the date field added_on, as the API
 does

---
 contacts.py            | 4 ++--
 tests/test_contacts.py | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/contacts.py b/contacts.py
index cb46917..b289194 100644
--- a/contacts.py
+++ b/contacts.py
@@ -3,8 +3,8 @@
 _CONTACTS = []
 
 
-def add(name, email, added):
-    _CONTACTS.append({"name": name, "email": email, "added": added})
+def add(name, email, added_on):
+    _CONTACTS.append({"name": name, "email": email, "added_on": added_on})
 
 
 def list_contacts():
diff --git a/tests/test_contacts.py b/tests/test_contacts.py
index af203ea..2f0ebac 100644
--- a/tests/test_contacts.py
+++ b/tests/test_contacts.py
@@ -18,6 +18,6 @@ def test_list_is_sorted_by_name():
     assert [c["name"] for c in contacts.list_contacts()] == ["Ana", "bo"]
 
 
-def test_list_keeps_the_date_added():
+def test_list_keeps_the_date_added_on():
     contacts.add("Ana", "ana@example.com", date(2026, 1, 3))
-    assert contacts.list_contacts()[0]["added"] == date(2026, 1, 3)
+    assert contacts.list_contacts()[0]["added_on"] == date(2026, 1, 3)
-- 
2.43.0

