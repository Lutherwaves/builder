+    def test_retries_until_the_relay_accepts(self):
+        attempts = []
+        waits = []
+
+        def flaky_relay(message):
+            attempts.append(message)
+            if len(attempts) < 3:
+                raise ConnectionRefusedError("relay busy")
+
+        accepted = mailer.send("ana@example.com", "hello", deliver=flaky_relay, sleep=waits.append)
+        self.assertTrue(accepted)
+        self.assertEqual(len(attempts), 3)
+        self.assertEqual(waits, [2, 2])
